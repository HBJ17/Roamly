# Copy to server/.env and fill in real values. Never commit the .env file.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/roamly_db

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d

# Comma separated list of allowed browser origins
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Razorpay (test mode keys). Leave blank to use the built-in sandbox gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP. Leave blank to log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Roamly <no-reply@roamly.local>

BOOKING_HOLD_MINUTES=15
GST_PERCENT=18
